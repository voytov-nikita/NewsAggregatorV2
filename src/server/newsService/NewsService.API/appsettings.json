{
  "ConnectionStrings": {
    "PostgreSql": "Host=localhost; Database=local-news; Username=postgres; Password=Qwerty123$%; Include Error Detail=true",
    "CommandTimeout": "30"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      },
      {
        "Name": "Console"
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithTreadId"]
  },
  "AllowedHosts": "*"
}
